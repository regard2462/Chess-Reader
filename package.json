{
  "name": "chess-reader",
  "productName": "Chess Reader",
  "version": "0.1.0",
  "description": "An e-reader for EPUB, PDF, MOBI, AZW3, FB2, CBZ, TXT, MD and HTML with a chess board that reads diagrams out of the pages.",
  "main": "electron/main.js",
  "author": "Chess Reader contributors",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "build": "node build/reader.js",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && node build/package-win.js",
    "dist:linux": "npm run build && node build/package-linux.js",
    "dist:mac": "npm run build && node build/package-mac.js",
    "build:android": "node build/android.js --release",
    "test": "npm run build && node build/reader-shot.js"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "hyphen": "^1.14.1",
    "jszip": "^3.10.1",
    "leaflet": "1.9.4",
    "mammoth": "^1.9.0",
    "marked": "^16.0.0",
    "stockfish": "^18.0.8",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.3.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.0",
    "resedit": "^3.1.0"
  }
}
